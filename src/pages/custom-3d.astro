---
import Layout from '../layouts/Layout.astro';
import CollectionHero from '../components/react/collection/CollectionHero.tsx';
import { CATEGORIES_CONFIG } from '../config/categoriesConfig';
import { LADY_JUSTICE_VARIANTS } from '../lib/api/customForge';

/**
 * Static hero image for Custom Forge inner page.
 * Reuses the existing inner-page category hero banner layout and styling.
 * Easy to replace later by modifying this path.
 */
const CUSTOM_FORGE_HERO_IMAGE = '/assets/categories/custom-forge/hero.webp';
const LADY_JUSTICE_IMAGE = '/assets/products/custom-forge/name plate front.png';

const customForgeCategory = {
  ...CATEGORIES_CONFIG['custom-forge'],
  heroImage: CUSTOM_FORGE_HERO_IMAGE,
  heroImageSize: { width: 1774, height: 887 }
};

const customForgeJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  'name': 'Custom Forge — THE MARSHANS',
  'provider': {
    '@type': 'Organization',
    'name': 'THE MARSHANS',
    'url': 'https://themarshans.shop'
  },
  'serviceType': 'Custom 3D Printing & Bespoke Sculptural Editions',
  'description': 'On-demand additive manufacturing and bespoke sculptural creations crafted with studio polymers and architectural balance.',
  'url': 'https://themarshans.shop/custom-3d/'
};
---

<Layout
  title="Custom Forge — On-Demand 3D Fabrication & Sculptures — THE MARSHANS"
  description="Precision on-demand additive manufacturing, bespoke sculptural pieces, and architectural creations by THE MARSHANS."
  canonical="https://themarshans.shop/custom-3d/"
  image={CUSTOM_FORGE_HERO_IMAGE}
  jsonLd={customForgeJsonLd}
>
  <div class="custom-forge-page">
    <!-- SECTION 1: STATIC INNER-PAGE HERO BANNER (Reusing existing CollectionHero layout and styling) -->
    <CollectionHero client:load category={customForgeCategory} />

    <!-- SECTION 2: CUSTOM FORGE LAUNCH SHOWCASE (Lady Justice) -->
    <section class="cf-landing-section" aria-labelledby="cf-landing-heading">
      <div class="container">
        <!-- Section Header -->
        <div class="cf-head">
          <span class="cf-badge">CUSTOM FORGE LAUNCH</span>
          <h1 id="cf-landing-heading" class="cf-title">
            Bespoke 3D Sculptures
          </h1>
          <p class="cf-intro">
            Welcome to THE MARSHANS Custom Forge. We combine advanced additive manufacturing with architectural finishing to create meaningful sculptural centerpieces crafted to order.
          </p>
        </div>

        <!-- Featured Product Presentation: Lady Justice -->
        <div class="cf-feature-card">
          <div class="cf-feature-media">
            <div class="cf-media-frame">
              <img
                src={LADY_JUSTICE_IMAGE}
                alt="Lady Justice Statue — THE MARSHANS Custom Forge"
                width="480"
                height="620"
                class="cf-sculpture-img"
                loading="eager"
                decoding="async"
              />
              <span class="cf-edition-pill">INITIAL LAUNCH EDITION</span>
            </div>
          </div>

          <div class="cf-feature-content">
            <div class="cf-product-meta">
              <span class="cf-category-eyebrow">CUSTOM FORGE · BESPOKE EDITION</span>
              <h2 class="cf-product-name">LADY JUSTICE</h2>
              <p class="cf-product-tagline">
                A symbol of truth, fairness and justice. Thoughtfully crafted to bring meaning and character to your chamber, gallery, or study.
              </p>
            </div>

            <!-- Size Editions & Pricing Table -->
            <div class="cf-sizes-block">
              <h3 class="cf-block-title">Available Size Editions & Pricing</h3>
              <div class="cf-sizes-grid">
                {LADY_JUSTICE_VARIANTS.map((v) => (
                  <div class="cf-size-card">
                    <div class="cf-size-top">
                      <strong class="cf-size-label">{v.sizeLabel}</strong>
                      <span class="cf-size-height">{v.heightMm} mm</span>
                    </div>
                    <div class="cf-size-price">
                      <span>₹{v.price.toLocaleString('en-IN')}</span>
                      <small class="cf-tax-note">incl. GST</small>
                    </div>
                    <p class="cf-size-desc">{v.description}</p>
                    <span class={`cf-custom-badge ${v.customModeAllowed ? 'eligible' : 'standard'}`}>
                      {v.customModeAllowed ? '✓ Custom Mode Available' : 'Standard Edition'}
                    </span>
                  </div>
                ))}
              </div>
            </div>

            <!-- Custom Mode Highlights -->
            <div class="cf-customization-explainer">
              <div class="cf-explainer-head">
                <span class="cf-sparkle-icon">✦</span>
                <strong class="cf-explainer-title">Personalized Nameplate Customization</strong>
              </div>
              <p class="cf-explainer-text">
                The 1-foot and 2-feet editions feature our signature <strong>Custom Mode</strong> at no additional charge. Configure a personalized 3D-printed plaque mounted seamlessly to the pedestal:
              </p>
              <ul class="cf-features-list">
                <li><strong>Recipient / Honor Name:</strong> Up to 35 characters engraved with crisp fidelity.</li>
                <li><strong>Designation or Chamber:</strong> Up to 50 characters (or enter <em>NIL</em>).</li>
                <li><strong>Material Options:</strong> High-definition Precision Polymer or warm Engineered Wood (MDF).</li>
                <li><strong>All-Inclusive Pricing:</strong> All stated prices include GST and Store 2 fulfillment guarantees.</li>
              </ul>
            </div>

            <!-- Action CTA -->
            <div class="cf-cta-row">
              <a href="/product/lady-justice/" class="cf-primary-cta">
                <span>Customize &amp; Order Lady Justice</span>
                <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
                  <line x1="4" y1="10" x2="16" y2="10" />
                  <polyline points="11 5 16 10 11 15" />
                </svg>
              </a>
              <span class="cf-cta-caption">Explore all sizes, preview custom nameplate, and configure your piece.</span>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style is:global>
  :root {
    --page-bg: #faf9f7;
  }

  .custom-forge-page {
    width: 100%;
    background-color: #faf9f7;
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    overflow-x: hidden;
    font-family: var(--font-sans, 'Manrope', -apple-system, sans-serif);
    margin-top: calc(-1 * var(--site-nav-h, 88px));
  }

  /* Extended Cinematic Hero for Custom Forge */
  .custom-forge-page .collection-hero-banner {
    width: 100%;
    height: clamp(520px, 38vw, 560px);
    max-height: 560px;
    position: relative;
    overflow: hidden;
    background: #faf9f7;
  }

  .custom-forge-page .collection-hero-banner-img {
    width: 100%;
    height: 100%;
    max-height: none !important;
    object-fit: cover !important;
    object-position: center 10% !important;
  }

  @media (max-width: 768px) {
    .custom-forge-page .collection-hero-banner {
      height: clamp(360px, 95vw, 400px);
      max-height: 400px;
    }

    .custom-forge-page .collection-hero-banner-img {
      object-position: 15% 10% !important;
    }
  }

  .cf-landing-section {
    padding: clamp(3rem, 5vw, 5rem) 0 clamp(4rem, 6vw, 6rem);
    background-color: #faf9f7;
  }

  .container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1.5rem;
    box-sizing: border-box;
  }

  .cf-head {
    max-width: 720px;
    margin: 0 auto clamp(2.5rem, 4vw, 3.5rem);
    text-align: center;
  }

  .cf-badge {
    display: inline-block;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #705e4d;
    background: rgba(140, 109, 59, 0.1);
    padding: 4px 14px;
    border-radius: 9999px;
    margin-bottom: 0.75rem;
    border: 1px solid rgba(140, 109, 59, 0.2);
  }

  .cf-title {
    margin: 0 0 1rem;
    font-size: clamp(32px, 4.5vw, 52px);
    font-weight: 850;
    letter-spacing: -0.03em;
    color: #14251a;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .cf-intro {
    font-size: clamp(15px, 1.25vw, 17px);
    line-height: 1.65;
    color: #556358;
    margin: 0;
  }

  /* Feature Card Presentation */
  .cf-feature-card {
    background: #ffffff;
    border: 1px solid rgba(20, 37, 26, 0.08);
    border-radius: 20px;
    padding: clamp(1.5rem, 3.5vw, 3rem);
    box-shadow: 0 12px 40px rgba(20, 37, 26, 0.06);
    display: grid;
    grid-template-columns: 420px 1fr;
    gap: clamp(2rem, 4vw, 4rem);
    align-items: center;
  }

  .cf-feature-media {
    display: flex;
    justify-content: center;
  }

  .cf-media-frame {
    position: relative;
    width: 100%;
    max-width: 380px;
    background: linear-gradient(180deg, #f7f5f0 0%, #ebe7dd 100%);
    border-radius: 16px;
    padding: 2.5rem 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    box-shadow: inset 0 2px 6px rgba(255, 255, 255, 0.8), 0 8px 24px rgba(20, 37, 26, 0.05);
  }

  .cf-sculpture-img {
    width: 100%;
    max-width: 280px;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 14px 28px rgba(20, 37, 26, 0.15));
    transition: transform 0.4s ease;
  }

  .cf-feature-card:hover .cf-sculpture-img {
    transform: scale(1.02) rotate(-0.5deg);
  }

  .cf-edition-pill {
    margin-top: 1.25rem;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.14em;
    color: #705e4d;
    background: #ffffff;
    padding: 4px 12px;
    border-radius: 9999px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  }

  /* Content Column */
  .cf-feature-content {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .cf-category-eyebrow {
    display: block;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #8c6d3b;
    margin-bottom: 0.5rem;
  }

  .cf-product-name {
    margin: 0 0 0.75rem;
    font-size: clamp(28px, 3.5vw, 40px);
    font-weight: 850;
    letter-spacing: -0.025em;
    color: #14251a;
  }

  .cf-product-tagline {
    font-size: 15px;
    line-height: 1.6;
    color: #4b584f;
    margin: 0;
  }

  /* Sizes Block */
  .cf-sizes-block {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .cf-block-title {
    margin: 0;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #14251a;
  }

  .cf-sizes-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }

  .cf-size-card {
    background: #faf9f7;
    border: 1px solid rgba(20, 37, 26, 0.08);
    border-radius: 10px;
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .cf-size-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .cf-size-label {
    font-size: 13px;
    font-weight: 800;
    color: #14251a;
  }

  .cf-size-height {
    font-size: 11px;
    color: #71717a;
  }

  .cf-size-price {
    display: flex;
    align-items: baseline;
    gap: 4px;
    font-size: 15px;
    font-weight: 850;
    color: #8c6d3b;
  }

  .cf-tax-note {
    font-size: 10px;
    font-weight: 600;
    color: #71717a;
  }

  .cf-size-desc {
    font-size: 11px;
    line-height: 1.4;
    color: #556358;
    margin: 4px 0 6px;
    flex: 1;
  }

  .cf-custom-badge {
    font-size: 10px;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 6px;
    width: fit-content;
  }

  .cf-custom-badge.eligible {
    background: rgba(21, 128, 61, 0.1);
    color: #15803d;
  }

  .cf-custom-badge.standard {
    background: #f4f4f5;
    color: #71717a;
  }

  /* Customization Explainer */
  .cf-customization-explainer {
    background: #faf7f2;
    border: 1px solid #ebdccb;
    border-radius: 12px;
    padding: 16px;
  }

  .cf-explainer-head {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 6px;
  }

  .cf-sparkle-icon {
    color: #8c6d3b;
    font-size: 14px;
  }

  .cf-explainer-title {
    font-size: 13px;
    font-weight: 800;
    color: #705322;
  }

  .cf-explainer-text {
    font-size: 13px;
    line-height: 1.5;
    color: #57431e;
    margin: 0 0 10px;
  }

  .cf-features-list {
    margin: 0;
    padding-left: 1.25rem;
    font-size: 12px;
    line-height: 1.6;
    color: #57431e;
  }

  .cf-features-list li {
    margin-bottom: 2px;
  }

  /* CTA Row */
  .cf-cta-row {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .cf-primary-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: #14251a;
    color: #ffffff;
    text-decoration: none;
    padding: 14px 28px;
    border-radius: 10px;
    font-size: 15px;
    font-weight: 750;
    letter-spacing: 0.02em;
    transition: background 0.15s ease, transform 0.15s ease;
    width: fit-content;
  }

  .cf-primary-cta:hover {
    background: #233c2c;
    transform: translateY(-2px);
  }

  .cf-cta-caption {
    font-size: 12px;
    color: #71717a;
  }

  @media (max-width: 960px) {
    .cf-feature-card {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .cf-feature-content {
      align-items: center;
    }
    .cf-custom-badge {
      margin: 0 auto;
    }
    .cf-features-list {
      text-align: left;
    }
    .cf-primary-cta {
      width: 100%;
    }
  }

  @media (max-width: 600px) {
    .cf-sizes-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
