---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEO from '../components/SEO.astro';
import '../styles/typography.css';
import '../styles/global.css';
import '../styles/hero.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  type?: 'website' | 'article' | 'product';
  noindex?: boolean;
  jsonLd?: Record<string, any> | Array<Record<string, any>>;
  hideHeader?: boolean;
  hideFooter?: boolean;
}

const {
  title,
  description,
  canonical,
  image,
  type = 'website',
  noindex = false,
  jsonLd,
  hideHeader = false,
  hideFooter = false
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Centralized SEO & Favicon -->
    <SEO
      title={title}
      description={description}
      canonical={canonical}
      image={image}
      type={type}
      noindex={noindex}
      jsonLd={jsonLd}
    />

    <!-- Google Fonts: Bebas Neue + Manrope -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Early execution script to prevent hero flash on Home navigation -->
    <script is:inline>
      (function() {
        try {
          if (window.location.pathname === '/' || window.location.pathname === '') {
            var isReload = false;
            var navEntries = performance.getEntriesByType('navigation');
            if (navEntries.length > 0) {
              isReload = navEntries[0].type === 'reload';
            } else if (performance.navigation) {
              isReload = performance.navigation.type === 1;
            }

            var isHashSkip = window.location.hash === '#home-carousel-section' || window.location.hash === '#home-navbar';
            var isParamSkip = window.location.search.indexOf('skip_hero=true') !== -1;
            var isCompleted = sessionStorage.getItem('marshans_home_intro_completed') === 'true';
            var isInternalReferrer = false;

            if (document.referrer) {
              try {
                var refUrl = new URL(document.referrer);
                if (refUrl.origin === window.location.origin && refUrl.pathname !== '/') {
                  isInternalReferrer = true;
                }
              } catch(e) {}
            }

            if (isReload) {
              // Explicit reload on '/': show hero
              sessionStorage.removeItem('marshans_home_intro_completed');
              document.documentElement.classList.remove('skip-home-hero');
            } else if (isHashSkip || isParamSkip || isCompleted || isInternalReferrer) {
              // Navigating from another page or already completed: collapse hero immediately
              document.documentElement.classList.add('skip-home-hero');
            }
          }
        } catch(e) {}
      })();
    </script>
  </head>
  <body class="site-body">
    {!hideHeader && <Header />}
    <main id="main-content" class="site-main">
      <slot />
    </main>
    {!hideFooter && <Footer />}
  </body>
</html>

<style>
  .site-body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    min-height: 100dvh;
    background-color: var(--color-bg, #ffffff);
  }

  .site-main {
    flex: 1 0 auto;
    width: 100%;
  }
</style>
