---
import Layout from '../../layouts/Layout.astro';
import LadyJusticePurchase from '../../components/react/LadyJusticePurchase.tsx';
import ProductGallery from '../../components/react/ProductGallery.tsx';
import { getLogoHref, isCustomForgeOnly } from '../../config/launchMode';

/**
 * Lady Justice curated photography and architectural gallery.
 * Features primary transparent render, studio portrait, clean lotus plinth, and detail infographic.
 */
const LADY_JUSTICE_PRIMARY_IMAGE = '/assets/products/custom-forge/lady-justice-statue.png';
const LADY_JUSTICE_THUMB_IMAGE = '/assets/products/custom-forge/lady-justice-statue-thumb.png';

const ladyJusticeGalleryItems = [
  {
    id: 'cf-lj-primary',
    image_url: '/assets/products/custom-forge/lady-justice-statue.png',
    thumbnail_url: '/assets/products/custom-forge/lady-justice-statue-thumb.png',
    is_primary: true
  },
  {
    id: 'cf-lj-studio',
    image_url: '/assets/products/custom-forge/lady-justice-statue-studio.jpeg',
    thumbnail_url: '/assets/products/custom-forge/lady-justice-statue-studio.jpeg'
  },
  {
    id: 'cf-lj-angle-2',
    image_url: '/assets/products/custom-forge/lady-justice-statue-angle-2.jpeg',
    thumbnail_url: '/assets/products/custom-forge/lady-justice-statue-angle-2.jpeg'
  },
  {
    id: 'cf-lj-details',
    image_url: '/assets/products/custom-forge/lady-justice-statue-details.jpeg',
    thumbnail_url: '/assets/products/custom-forge/lady-justice-statue-details.jpeg'
  }
];

const canonicalUrl = 'https://themarshans.shop/product/lady-justice/';
const productTitle = 'LADY JUSTICE — THE MARSHANS | Custom Forge';
const productDescription =
  'A symbol of truth, fairness and justice. A statement piece inspired by Lady Justice, thoughtfully crafted to bring meaning and character to your space.';
const productImage = LADY_JUSTICE_PRIMARY_IMAGE;

const homeHref = getLogoHref();

const ladyJusticeJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Product',
      'name': 'LADY JUSTICE',
      'image': `https://themarshans.shop${productImage}`,
      'description': productDescription,
      'brand': {
        '@type': 'Brand',
        'name': 'THE MARSHANS'
      },
      'category': 'Custom Forge',
      'offers': {
        '@type': 'AggregateOffer',
        'priceCurrency': 'INR',
        'lowPrice': 1600,
        'highPrice': 5600,
        'offerCount': 3
      }
    },
    {
      '@type': 'BreadcrumbList',
      'itemListElement': [
        {
          '@type': 'ListItem',
          'position': 1,
          'name': 'Home',
          'item': `https://themarshans.shop${homeHref}`
        },
        {
          '@type': 'ListItem',
          'position': 2,
          'name': 'Custom Forge',
          'item': 'https://themarshans.shop/custom-3d'
        },
        {
          '@type': 'ListItem',
          'position': 3,
          'name': 'Lady Justice',
          'item': canonicalUrl
        }
      ]
    }
  ]
};
---

<Layout
  title={productTitle}
  description={productDescription}
  canonical={canonicalUrl}
  image={productImage}
  type="product"
  jsonLd={ladyJusticeJsonLd}
>
  <main class="product-page-root">
    <div class="container">
      <!-- Breadcrumb Navigation -->
      <div class="breadcrumbs-container">
        <nav class="breadcrumbs-nav" aria-label="Breadcrumb">
          <a href={homeHref}>Home</a>
          <span class="breadcrumb-sep" aria-hidden="true">/</span>
          <a href="/custom-3d">Custom Forge</a>
          <span class="breadcrumb-sep" aria-hidden="true">/</span>
          <span class="breadcrumb-current" aria-current="page">Lady Justice</span>
        </nav>
      </div>

      <!-- Main Product Detail Grid -->
      <section class="lady-detail-grid">
        <!-- Left Column: Master Product Gallery -->
        <div class="lady-stage-col">
          <ProductGallery
            client:load
            images={ladyJusticeGalleryItems}
            productName="LADY JUSTICE"
            categoryName="Custom Forge"
            badge="Custom Forge Edition"
          />
        </div>

        <!-- Right Column: Editorial Product Narrative & Purchase Integration -->
        <div class="lady-info-col">
          <div class="lady-collection-tag-row">
            <a href="/custom-3d" class="lady-collection-link">
              CUSTOM FORGE COLLECTION
            </a>
          </div>

          <h1 class="lady-product-title">
            LADY JUSTICE
          </h1>

          <p class="lady-product-tagline">
            A symbol of truth, fairness and justice.
          </p>

          <p class="lady-product-desc">
            A statement piece inspired by Lady Justice, thoughtfully crafted to bring meaning and character to your space.
          </p>

          <!-- Dynamic Client Purchase / Availability Island -->
          <LadyJusticePurchase client:load />

          <!-- Editorial Architecture & Craft Notes -->
          <div class="lady-craft-section">
            <h2 class="lady-craft-heading">Craftsmanship & Character</h2>
            <div class="lady-craft-grid">
              <div class="lady-craft-item">
                <span class="lady-craft-num">01</span>
                <div>
                  <h3 class="lady-craft-title">Sculptural Presence</h3>
                  <p class="lady-craft-text">
                    Engineered with balanced geometry, capturing the blindfold of impartiality, the scales of evidence, and the sword of authority in harmonious proportion.
                  </p>
                </div>
              </div>
              <div class="lady-craft-item">
                <span class="lady-craft-num">02</span>
                <div>
                  <h3 class="lady-craft-title">Precision Fabrication</h3>
                  <p class="lady-craft-text">
                    Formed through high-precision additive manufacturing, retaining pure contours and an authentic tactile finish.
                  </p>
                </div>
              </div>
              <div class="lady-craft-item">
                <span class="lady-craft-num">03</span>
                <div>
                  <h3 class="lady-craft-title">Archival Presentation</h3>
                  <p class="lady-craft-text">
                    Every Custom Forge creation is delivered in custom-padded protective packaging tailored for display and preservation.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    </div>
  </main>
</Layout>

<style is:global>
  .product-page-root {
    background-color: #faf9f7;
    padding-bottom: 96px;
    width: 100%;
    box-sizing: border-box;
    overflow-x: hidden;
  }

  .container {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 1.5rem;
    box-sizing: border-box;
  }

  /* Breadcrumbs */
  .breadcrumbs-container {
    padding-top: 24px;
    padding-bottom: 24px;
  }

  .breadcrumbs-nav {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-sans, 'Manrope', -apple-system, sans-serif);
    font-size: 12px;
    font-weight: 500;
    color: #71717a;
    flex-wrap: wrap;
    letter-spacing: 0.02em;
  }

  .breadcrumbs-nav a {
    color: #71717a;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .breadcrumbs-nav a:hover {
    color: #14251a;
  }

  .breadcrumb-sep {
    color: #d4d4d8;
    font-size: 10px;
  }

  .breadcrumb-current {
    color: #14251a;
    font-weight: 700;
  }

  /* Two-column Product Detail Layout */
  .lady-detail-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    margin-top: 0.5rem;
    align-items: start;
  }

  @media (min-width: 768px) {
    .lady-detail-grid {
      grid-template-columns: minmax(340px, 1fr) 1fr;
      gap: 2.5rem;
    }
  }

  @media (min-width: 1024px) {
    .lady-detail-grid {
      grid-template-columns: minmax(440px, 1.15fr) 1fr;
      gap: 3.5rem;
    }
  }

  /* Left Column: Stage */
  .lady-stage-col {
    width: 100%;
  }

  .lady-stage-card {
    position: relative;
    background: #ffffff;
    border: 1px solid rgba(20, 37, 26, 0.08);
    border-radius: 20px;
    padding: clamp(2rem, 5vw, 4rem) 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 540px;
    perspective: 1200px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(20, 37, 26, 0.04);
  }

  .lady-stage-pedestal {
    position: absolute;
    bottom: 24px;
    width: 75%;
    height: 70px;
    background: radial-gradient(
      ellipse 60% 40% at 50% 50%,
      rgba(20, 37, 26, 0.14) 0%,
      rgba(140, 109, 59, 0.06) 40%,
      transparent 70%
    );
    filter: blur(10px);
    pointer-events: none;
    z-index: 1;
  }

  .lady-statue-rotator {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    transform-style: preserve-3d;
    will-change: transform;
    animation: ladyDetailTurn 16s ease-in-out infinite;
  }

  @keyframes ladyDetailTurn {
    0%, 100% {
      transform: perspective(1200px) rotateY(-6deg) rotateX(2deg) translateY(0);
    }
    50% {
      transform: perspective(1200px) rotateY(6deg) rotateX(-1deg) translateY(-8px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lady-statue-rotator {
      animation: none !important;
      transform: perspective(1200px) rotateY(-2deg) !important;
    }
  }

  .lady-statue-hero-img {
    display: block;
    max-width: 100%;
    width: auto;
    height: auto;
    max-height: clamp(380px, 60vh, 620px);
    object-fit: contain;
    filter:
      drop-shadow(0 20px 35px rgba(20, 37, 26, 0.14))
      drop-shadow(0 4px 12px rgba(20, 37, 26, 0.06));
    transition: transform 0.3s ease;
  }

  .lady-stage-card:hover .lady-statue-hero-img {
    transform: scale(1.02);
  }

  .lady-stage-badge {
    position: absolute;
    bottom: 18px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-sans, 'Manrope', -apple-system, sans-serif);
    font-size: 11px;
    font-weight: 700;
    color: #52525b;
    background: #faf9f7;
    padding: 6px 14px;
    border-radius: 9999px;
    border: 1px solid #e4e4e7;
    z-index: 3;
  }

  .lady-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #2f6b45;
  }

  /* Right Column: Info & Narrative */
  .lady-info-col {
    display: flex;
    flex-direction: column;
    font-family: var(--font-sans, 'Manrope', -apple-system, sans-serif);
  }

  .lady-collection-tag-row {
    margin-bottom: 0.75rem;
  }

  .lady-collection-link {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #2f6b45;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .lady-collection-link:hover {
    color: #14251a;
    text-decoration: underline;
  }

  .lady-product-title {
    margin: 0 0 0.75rem;
    font-size: clamp(32px, 3.8vw, 48px);
    font-weight: 850;
    letter-spacing: -0.025em;
    line-height: 1.1;
    color: #14251a;
  }

  .lady-product-tagline {
    margin: 0 0 1rem;
    font-size: clamp(16px, 1.6vw, 19px);
    font-weight: 600;
    color: #2a3d30;
    line-height: 1.45;
  }

  .lady-product-desc {
    margin: 0 0 1.25rem;
    font-size: 15px;
    font-weight: 400;
    line-height: 1.65;
    color: #52525b;
  }

  /* Craftsmanship section */
  .lady-craft-section {
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(20, 37, 26, 0.08);
  }

  .lady-craft-heading {
    margin: 0 0 1.5rem;
    font-size: 16px;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: #14251a;
    text-transform: uppercase;
  }

  .lady-craft-grid {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .lady-craft-item {
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }

  .lady-craft-num {
    font-size: 12px;
    font-weight: 800;
    color: #2f6b45;
    background: rgba(47, 107, 69, 0.08);
    padding: 3px 7px;
    border-radius: 4px;
    flex-shrink: 0;
  }

  .lady-craft-title {
    margin: 0 0 4px;
    font-size: 14px;
    font-weight: 750;
    color: #14251a;
  }

  .lady-craft-text {
    margin: 0;
    font-size: 13px;
    line-height: 1.55;
    color: #52525b;
  }
</style>
