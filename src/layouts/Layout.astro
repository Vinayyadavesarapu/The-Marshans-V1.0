---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEO from '../components/SEO.astro';
import '../styles/typography.css';
import '../styles/global.css';
import '../styles/hero.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  type?: 'website' | 'article' | 'product';
  noindex?: boolean;
  jsonLd?: Record<string, any> | Array<Record<string, any>>;
  hideHeader?: boolean;
  hideFooter?: boolean;
}

const {
  title,
  description,
  canonical,
  image,
  type = 'website',
  noindex = false,
  jsonLd,
  hideHeader = false,
  hideFooter = false
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Centralized SEO & Favicon -->
    <SEO
      title={title}
      description={description}
      canonical={canonical}
      image={image}
      type={type}
      noindex={noindex}
      jsonLd={jsonLd}
    />

    <!-- Google Analytics (GA4) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-2XPFN32BRR"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-2XPFN32BRR');
    </script>

    <!-- Google Fonts: Bebas Neue + Manrope -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body class="site-body">
    {!hideHeader && <Header />}
    <main id="main-content" class="site-main">
      <slot />
    </main>
    {!hideFooter && <Footer />}

    <!-- Centralized Screen-Level Auth Error Notification Toast -->
    <div id="marshans-auth-toast" class="marshans-screen-auth-toast" role="alert" aria-live="assertive">
      <div class="toast-card">
        <span class="toast-badge">COLLECTOR ACCESS</span>
        <p id="marshans-auth-toast-message" class="toast-msg">Please sign in to continue.</p>
        <div class="toast-actions">
          <a id="marshans-auth-toast-link" href="/login" class="toast-btn-login">Sign In</a>
          <button type="button" id="marshans-auth-toast-close" class="toast-btn-dismiss" aria-label="Dismiss">✕</button>
        </div>
      </div>
    </div>

    <script is:inline>
      (function() {
        var toast = document.getElementById('marshans-auth-toast');
        var msgEl = document.getElementById('marshans-auth-toast-message');
        var linkEl = document.getElementById('marshans-auth-toast-link');
        var closeBtn = document.getElementById('marshans-auth-toast-close');
        var timer = null;
        if (!toast) return;

        window.addEventListener('marshans:auth-error', function(e) {
          var detail = e.detail || {};
          if (msgEl) msgEl.textContent = detail.message || 'Please sign in to continue.';
          if (linkEl && detail.redirect) {
            linkEl.href = '/login?redirect=' + encodeURIComponent(detail.redirect);
          }
          toast.classList.add('is-visible');
          clearTimeout(timer);
          timer = setTimeout(function() {
            toast.classList.remove('is-visible');
          }, 6000);
        });

        if (closeBtn) {
          closeBtn.addEventListener('click', function() {
            clearTimeout(timer);
            toast.classList.remove('is-visible');
          });
        }
      })();
    </script>
  </body>
</html>

<style>
  .site-body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    min-height: 100dvh;
    background-color: var(--color-bg, #ffffff);
  }

  .site-main {
    flex: 1 0 auto;
    width: 100%;
  }

  .marshans-screen-auth-toast {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 9999;
    opacity: 0;
    visibility: hidden;
    transform: translateY(12px);
    transition: opacity 0.25s ease, transform 0.25s ease, visibility 0.25s;
    pointer-events: none;
    max-width: 380px;
  }

  .marshans-screen-auth-toast.is-visible {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto;
  }

  .toast-card {
    background: #09090b;
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 12px;
    padding: 16px 20px;
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.45);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .toast-badge {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #e2e8f0;
    text-transform: uppercase;
  }

  .toast-msg {
    font-size: 13px;
    line-height: 1.4;
    color: #94a3b8;
    margin: 0;
  }

  .toast-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 4px;
    gap: 12px;
  }

  .toast-btn-login {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #ffffff;
    color: #09090b;
    font-weight: 700;
    font-size: 12px;
    padding: 6px 14px;
    border-radius: 6px;
    text-decoration: none;
    transition: background 0.15s;
  }

  .toast-btn-login:hover {
    background: #e2e8f0;
  }

  .toast-btn-dismiss {
    background: transparent;
    border: none;
    color: #64748b;
    font-size: 16px;
    cursor: pointer;
    padding: 4px;
    line-height: 1;
    transition: color 0.15s;
  }

  .toast-btn-dismiss:hover {
    color: #ffffff;
  }

  @media (max-width: 640px) {
    .marshans-screen-auth-toast {
      left: 16px;
      right: 16px;
      bottom: 16px;
      max-width: none;
    }
  }
</style>
