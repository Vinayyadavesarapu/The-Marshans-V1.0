---
import MarshansNavbar from './react/MarshansNavbar.tsx';
import HomeCarousel from './home/HomeCarousel.tsx';
---

<div class="hero-page-flow">
  <!-- ==========================================
       1. MAIN NAVIGATION
       ========================================== -->
  <section class="hero-navbar-section" id="home-navbar" aria-label="Main Navigation">
    <MarshansNavbar client:load />
  </section>

  <!-- ==========================================
       2. HOME CAROUSEL
       ========================================== -->
  <section class="home-carousel-section" id="home-carousel-section" aria-label="Home Exhibition Carousel">
    <HomeCarousel client:load />
  </section>
</div>

<style>
  .hero-page-flow {
    width: 100%;
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    border: none;
    border-radius: 0;
  }

  .hero-navbar-section {
    width: 100%;
    margin: 0;
    padding: 0;
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .home-carousel-section {
    width: 100%;
    margin: 0;
    padding: 2rem 0 2rem;
    box-sizing: border-box;
    position: relative;
    z-index: 5;
    border: none;
    border-radius: 0;
  }

  @media (max-width: 768px) {
    .home-carousel-section {
      padding: 1.5rem 0 1.5rem;
    }
  }
</style>
