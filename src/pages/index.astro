---
import Layout from '../layouts/Layout.astro';
import HeroIntro from '../components/HeroIntro.astro';
import HomeCategoryDiscovery from '../components/home/HomeCategoryDiscovery.astro';
import HomeShowcase from '../components/home/HomeShowcase.tsx';
import HomeLadyJusticeFeature from '../components/home/HomeLadyJusticeFeature.astro';
import HomeProductSection from '../components/react/HomeProductSection.tsx';
import { getProducts } from '../lib/api/products';
import { isCustomForgeOnly } from '../config/launchMode';

// Centralized launch-mode guard: redirect old retail homepage to Custom Forge landing page
if (isCustomForgeOnly()) {
  return Astro.redirect('/custom-3d', 302);
}

const { products } = await getProducts({ limit: 12 });
---

<Layout
  title="THE MARSHANS — Made to be Discovered | Precision 3D Printed Artifacts"
  description="Precision 3D printed artifacts, ambient luminous sculptures, collectible figures, and functional desk gear."
>
  <!-- 1. Cinematic cloud/video hero, rendered above the shared site navbar (2. Layout's sticky Header) -->
  <HeroIntro slot="before-header" />

  <!-- 3. Category discovery carousel: the collections, not products -->
  <HomeCategoryDiscovery />

  <!-- 4. New Arrivals showcase carousel -->
  <HomeShowcase client:visible={{ rootMargin: "600px" }} initialProducts={products} />

  <!-- 5. Lady Justice Custom Forge Feature Banner -->
  <HomeLadyJusticeFeature />

  <!-- 6. Homepage catalogue (runtime capable) -->
  <div class="home-catalogue-head">
    <h2 class="home-catalogue-title">The Collection</h2>
    <a class="home-catalogue-link" href="/shop">Browse the full shop →</a>
  </div>
  <HomeProductSection client:load initialProducts={products} />
</Layout>

<style is:global>
  /* The homepage's cream page background (previously painted only behind the navbar); the transparent navbar shows it */
  :root {
    --page-bg: #f6eee4;
  }

  .home-catalogue-head {
    width: 100%;
    margin: 0;
    /* full-width band; content aligned with the 1440px catalogue column */
    padding: 0.5rem max(1.5rem, calc((100% - 1440px) / 2 + 1.5rem)) 0.25rem;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    box-sizing: border-box;
    background-color: #faf9f7;
  }

  .home-section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.25rem;
  }

  .home-catalogue-title {
    margin: 0;
    font-family: var(--font-sans, 'Manrope', -apple-system, sans-serif);
    font-size: clamp(24px, 3vw, 36px);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: #14251a;
  }

  .home-catalogue-link {
    font-family: var(--font-sans, 'Manrope', -apple-system, sans-serif);
    font-size: 14px;
    font-weight: 700;
    color: #2f6b45;
    text-decoration: none;
  }

  .home-catalogue-link:hover {
    text-decoration: underline;
  }

  /* Homepage catalogue: isolated renders sit fully inside the card (no cropping); transparent WebP stays
     transparent over a white stage, and the reserved aspect ratio prevents layout shift. */
  #product-cards .marshans-image-stage,
  #home-best-sellers .marshans-image-stage {
    background: #ffffff;
  }

  #product-cards .marshans-product-img,
  #home-best-sellers .marshans-product-img {
    object-fit: contain;
    padding: 6%;
    box-sizing: border-box;
  }

  .home-products-section {
    width: 100%;
    padding: 2.5rem 0 5rem;
    box-sizing: border-box;
    background-color: #faf9f7;
  }

  .home-products-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    width: 100%;
    box-sizing: border-box;
  }

  @media (max-width: 1100px) {
    .home-products-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 768px) {
    .home-products-section {
      padding: 1.5rem 0 3.5rem;
    }

    .home-products-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
      max-width: 100%;
    }
  }

  @media (max-width: 480px) {
    .home-products-grid {
      grid-template-columns: 1fr;
      max-width: 340px;
      margin: 0 auto;
    }
  }
</style>
