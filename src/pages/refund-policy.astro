---
import Layout from '../layouts/Layout.astro';

const lastUpdatedDate = 'October 24, 2024';
const effectiveDate = 'October 24, 2024';

const refundJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  'name': 'Refund Policy — THE MARSHANS',
  'url': 'https://themarshans.shop/refund-policy',
  'description': 'Comprehensive refund, return, replacement, and cancellation policy for FDM and resin 3D printed artifacts by THE MARSHANS.',
  'publisher': {
    '@type': 'Organization',
    'name': 'THE MARSHANS',
    'url': 'https://themarshans.shop',
    'legalName': 'THE MARSHANS',
    'address': {
      '@type': 'PostalAddress',
      'streetAddress': 'Villa no 31 E, Hirise meadows, Mallampet, bachhupally',
      'addressLocality': 'Hyderabad',
      'postalCode': '500090',
      'addressRegion': 'Telangana',
      'addressCountry': 'IN'
    }
  }
};
---

<Layout
  title="THE MARSHANS — Refund & Cancellation Policy"
  description="Transparent and fair refund, return, replacement, and cancellation guidelines for THE MARSHANS 3D-printed creations and custom prints."
  canonical="https://themarshans.shop/refund-policy"
  jsonLd={refundJsonLd}
>
  <div class="legal-page-wrapper">
    <!-- Header Section -->
    <header class="legal-header">
      <div class="container">
        <div class="legal-badge-row">
          <span class="legal-badge">CONSUMER PROTECTION & SATISFACTION</span>
          <span class="legal-date">Last Updated: {lastUpdatedDate}</span>
        </div>
        <h1 class="legal-title">REFUND & CANCELLATION POLICY</h1>
        <p class="legal-subtitle">
          At THE MARSHANS, every 3D-printed artifact is engineered with dedication and precision. We are committed to transparency, fair resolution, and honoring our statutory duties to our collectors and customers.
        </p>
        <div class="statutory-notice-card">
          <div class="statutory-notice-icon" aria-hidden="true">⚖️</div>
          <div class="statutory-notice-text">
            <strong>Mandatory Consumer Rights Guarantee:</strong>
            <p>Nothing in this Refund Policy limits any rights or remedies available to consumers under applicable law, including the Consumer Protection Act, 2019 and the Consumer Protection (E-Commerce) Rules, 2020.</p>
          </div>
        </div>
      </div>
    </header>

    <!-- Main Content Area -->
    <div class="container legal-body-container">
      <div class="legal-layout">
        <!-- Quick Table of Contents Sidebar -->
        <aside class="legal-sidebar" aria-label="Table of Contents">
          <div class="sidebar-sticky-box">
            <h3 class="sidebar-title">POLICY SECTIONS</h3>
            <nav class="toc-nav">
              <ol class="toc-list">
                <li><a href="#section-1">1. Policy Introduction</a></li>
                <li><a href="#section-2">2. Quick Refund Overview (Matrix)</a></li>
                <li><a href="#section-3">3. Standard Ready-Made Products</a></li>
                <li><a href="#section-4">4. Custom & Personalized Products</a></li>
                <li><a href="#section-5">5. Made-to-Order Products</a></li>
                <li><a href="#section-6">6. FDM 3D Print Quality Guidelines</a></li>
                <li><a href="#section-7">7. Resin 3D Print Quality Guidelines</a></li>
                <li><a href="#section-8">8. Items Damaged in Transit</a></li>
                <li><a href="#section-9">9. Wrong or Missing Items</a></li>
                <li><a href="#section-10">10. Materially Non-Conforming Products</a></li>
                <li><a href="#section-11">11. Change of Mind Requests</a></li>
                <li><a href="#section-12">12. Cancellation Before Production</a></li>
                <li><a href="#section-13">13. Cancellation After Production Starts</a></li>
                <li><a href="#section-14">14. Refund Method & Processing</a></li>
                <li><a href="#section-15">15. Refund Amount & Itemization</a></li>
                <li><a href="#section-16">16. How to Request a Refund / Remedy</a></li>
                <li><a href="#section-17">17. Refund & Quality Review Process</a></li>
                <li><a href="#section-18">18. Protection Against Fraudulent Claims</a></li>
                <li><a href="#section-19">19. Statutory Consumer Rights</a></li>
              </ol>
            </nav>
            <div class="sidebar-policy-link">
              <p>Need general storefront terms?</p>
              <a href="/terms-and-conditions" class="btn-text-link">View Terms & Conditions →</a>
            </div>
          </div>
        </aside>

        <!-- Policy Content -->
        <article class="legal-content">
          <!-- 1. Introduction -->
          <section id="section-1" class="policy-section">
            <span class="section-number">Section 01</span>
            <h2>1. Refund Policy Introduction</h2>
            <p>
              <strong>THE MARSHANS</strong> sells precision 3D-printed creations crafted using both <strong>Fused Deposition Modeling (FDM)</strong> and <strong>Photopolymer Resin (SLA/DLP/MSLA)</strong> technologies. Our product catalog comprises:
            </p>
            <ul>
              <li><strong>Ready-Made & Standard Products:</strong> Finished stock items manufactured according to uniform studio specifications.</li>
              <li><strong>Made-to-Order Products:</strong> Catalog designs produced on-demand after an order is placed and scheduled in our print queue.</li>
              <li><strong>Custom & Bespoke Prints:</strong> Tailored pieces personalized with customer names, unique colorways, specific dimensions, or fabricated directly from customer-uploaded CAD/STL files via our Custom Forge studio.</li>
            </ul>
            <p>
              Because additive manufacturing involves individual machine runtimes, polymer curing, and manual post-processing, refund, return, and cancellation eligibility depends on the <strong>nature of the product</strong>, the <strong>specific reason for the request</strong>, the <strong>production phase</strong> of the order, the <strong>condition of the item</strong>, and <strong>applicable Indian consumer protection laws</strong>.
            </p>
          </section>

          <!-- 2. Quick Refund Overview -->
          <section id="section-2" class="policy-section">
            <span class="section-number">Section 02</span>
            <h2>2. Quick Refund Overview</h2>
            <p>
              The table below outlines our standard resolution pathways for common situations. This matrix is provided for quick reference and does not alter your statutory rights.
            </p>
            <div class="table-responsive">
              <table class="policy-table">
                <thead>
                  <tr>
                    <th scope="col" style="width: 45%;">Issue / Situation</th>
                    <th scope="col" style="width: 55%;">Typical Resolution Pathway</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td><strong>Defective Product</strong><br /><span class="table-sub">Structural crack, major print failure, or component malfunction</span></td>
                    <td>Prompt engineering review; free replacement reprint or full refund as appropriate.</td>
                  </tr>
                  <tr>
                    <td><strong>Damaged in Transit</strong><br /><span class="table-sub">Crushed box, broken pieces caused by courier handling</span></td>
                    <td>Priority replacement reprint dispatched promptly, or refund upon verification.</td>
                  </tr>
                  <tr>
                    <td><strong>Wrong Product or Missing Item</strong><br /><span class="table-sub">Incorrect model, wrong colorway, or missing parts</span></td>
                    <td>Immediate shipment of the correct item/missing component at our expense, or refund if unavailable.</td>
                  </tr>
                  <tr>
                    <td><strong>Materially Incorrect Customization</strong><br /><span class="table-sub">Discrepancy caused by our studio failing to match confirmed custom details</span></td>
                    <td>Full corrective reprint at no extra charge, or full refund upon inspection.</td>
                  </tr>
                  <tr>
                    <td><strong>Change of Mind — Standard Product</strong><br /><span class="table-sub">Customer decides they no longer want a stock catalog item</span></td>
                    <td>Subject to return conditions: unused condition, original packaging, within 7 days of delivery. Return shipping handled as per policy.</td>
                  </tr>
                  <tr>
                    <td><strong>Change of Mind — Custom Product</strong><br /><span class="table-sub">Bespoke nameplate, custom STL upload, personalized model</span></td>
                    <td>Restricted once slicing approval, resin curing, or active machine extrusion has begun.</td>
                  </tr>
                  <tr>
                    <td><strong>Order Cancellation (Before Production)</strong><br /><span class="table-sub">Order placed but printing has not commenced</span></td>
                    <td>Full cancellation and 100% refund to original payment method.</td>
                  </tr>
                  <tr>
                    <td><strong>Order Cancellation (After Custom Production Begins)</strong><br /><span class="table-sub">Bespoke item already on the print bed or curing</span></td>
                    <td>Restricted due to irreversible material consumption and customized geometry, subject to applicable law.</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </section>

          <!-- 3. Standard Products -->
          <section id="section-3" class="policy-section">
            <span class="section-number">Section 03</span>
            <h2>3. Standard Ready-Made Products</h2>
            <p>
              For standard, non-personalized catalog products:
            </p>
            <ul>
              <li><strong>Reporting Window:</strong> If you identify an issue or seek a return for an eligible standard product, you must contact our customer support team within 7 days of recorded delivery.</li>
              <li><strong>Condition of Returned Goods:</strong> Items must be returned in their original, unused condition, complete with all original protective packaging, accessories, foam inserts, cables, and documentation.</li>
              <li><strong>Post-Delivery Damage:</strong> Damage resulting from drops, accidents, excessive heat exposure, chemical cleaning, or deliberate tampering after successful delivery is not eligible for return or refund.</li>
            </ul>
          </section>

          <!-- 4. Custom & Personalized Products -->
          <section id="section-4" class="policy-section">
            <span class="section-number">Section 04</span>
            <h2>4. Custom & Personalized Products</h2>
            <p>
              Custom products are built to unique customer specifications, including custom names, uploaded STL/3MF files, specialized dimensions, or bespoke finishes.
            </p>
            <div class="policy-box">
              <h4>Custom Print Guidelines</h4>
              <ul>
                <li><strong>Pre-Production Stage:</strong> You may cancel or amend your custom order without penalty if you contact us before CAD slicing approval and machine bed scheduling.</li>
                <li><strong>Production Stage Restriction:</strong> Once additive printing or photopolymer curing has commenced, change-of-mind cancellations or returns are restricted because the piece cannot be resold or repurposed.</li>
                <li><strong>Statutory Protections Retained:</strong> This restriction does <em>not</em> apply if the custom print arrives damaged in transit, suffers from a severe manufacturing defect, or materially deviates from the confirmed 3D file or agreed specifications. In such instances, customers are fully entitled to an immediate corrective reprint or appropriate refund.</li>
              </ul>
            </div>
          </section>

          <!-- 5. Made-to-Order Products -->
          <section id="section-5" class="policy-section">
            <span class="section-number">Section 05</span>
            <h2>5. Made-to-Order Products</h2>
            <p>
              Made-to-order catalog pieces (such as intricate LUMO ambient lamps or multi-part Darshanam shrines) are queued for fabrication upon order placement.
            </p>
            <p>
              If a cancellation request is received while the order is queued (before material setup and slicing execution), we will cancel the order and issue a full refund. If printing has already commenced, cancellation will be evaluated based on the progress of manufacturing, material consumption, and whether components can be inventoried for future orders.
            </p>
          </section>

          <!-- 6. FDM 3D Print Quality Guidelines -->
          <section id="section-6" class="policy-section">
            <span class="section-number">Section 06</span>
            <h2>6. FDM 3D Print Quality Guidelines</h2>
            <p>
              Fused Deposition Modeling creates three-dimensional forms by extruding layer upon layer of thermoplastic filament. We pride ourselves on printing at ultra-fine 0.12mm to 0.20mm layer heights on calibrated studio machines.
            </p>
            <div class="two-col-guidelines">
              <div class="guideline-card defective">
                <h4>Eligible Manufacturing Defects (Covered)</h4>
                <ul>
                  <li>Structural delamination (layers separating under normal handling);</li>
                  <li>Severe under-extrusion resulting in hollow or brittle walls;</li>
                  <li>Critical warping that prevents the model from sitting flat or assembling;</li>
                  <li>Gross dimensional deviations exceeding reasonable tolerances (e.g. over ±2.5%);</li>
                  <li>Broken, missing, or mechanically defective functional components.</li>
                </ul>
              </div>
              <div class="guideline-card normal">
                <h4>Normal Manufacturing Characteristics (Not Defects)</h4>
                <ul>
                  <li>Subtle, uniform micro-layer striations along the vertical axis;</li>
                  <li>Minor Z-seam lines where perimeter tracks begin and close;</li>
                  <li>Light surface texture on supported overhang facets;</li>
                  <li>Microscopic stringing or minute vestigial support touchpoints that do not affect structural integrity or aesthetic presentation.</li>
                </ul>
              </div>
            </div>
          </section>

          <!-- 7. Resin 3D Print Quality Guidelines -->
          <section id="section-7" class="policy-section">
            <span class="section-number">Section 07</span>
            <h2>7. Resin 3D Print Quality Guidelines</h2>
            <p>
              Photopolymer resin printing achieves museum-grade detailing and ultra-smooth finishes. We carefully distinguish authentic defects from natural light-cured characteristics:
            </p>
            <div class="two-col-guidelines">
              <div class="guideline-card defective">
                <h4>Eligible Resin Issues (Covered)</h4>
                <ul>
                  <li>Uncured liquid resin leakage or trapped uncured liquid inside cavities;</li>
                  <li>Severe cracking, splitting, or catastrophic layer shifting;</li>
                  <li>Missing anatomical features or broken fine appendages;</li>
                  <li>Brittle shatter upon arrival due to shipping stress or under-curing.</li>
                </ul>
              </div>
              <div class="guideline-card normal">
                <h4>Normal Resin Characteristics (Not Defects)</h4>
                <ul>
                  <li>Tiny micro-pips from microscopic support pin detachment;</li>
                  <li>Slight hand-sanding sheen variations in cleaned support contact zones;</li>
                  <li>Minute color hue shifts consistent with secondary UV light stabilization.</li>
                </ul>
              </div>
            </div>
          </section>

          <!-- 8. Items Damaged in Transit -->
          <section id="section-8" class="policy-section">
            <span class="section-number">Section 08</span>
            <h2>8. Items Damaged in Transit</h2>
            <p>
              We wrap and crate every product with heavy-duty shock absorption, but parcel carriers may occasionally mishandle packages during domestic transit.
            </p>
            <div class="policy-callout-action">
              <h4>Transit Damage Reporting Procedure</h4>
              <p>
                If your package arrives crushed, punctured, or you hear loose broken pieces inside, please notify us within 48 hours of parcel delivery.
              </p>
              <ul>
                <li>Retain all outer carton packaging, shipping labels, and internal cushioning.</li>
                <li>Capture clear photographs showing the outer box, shipping label with AWB number, and the damaged item.</li>
                <li>Send these photos with your Order Number to <a href="mailto:official@themarshans.shop">official@themarshans.shop</a>.</li>
              </ul>
              <p>We will immediately initiate a priority replacement reprint or process a refund upon verification.</p>
            </div>
          </section>

          <!-- 9. Wrong or Missing Items -->
          <section id="section-9" class="policy-section">
            <span class="section-number">Section 09</span>
            <h2>9. Wrong or Missing Items</h2>
            <p>
              In the unlikely event that your delivery contains an incorrect model, incorrect color variant, or is missing a secondary component:
            </p>
            <ul>
              <li>Contact support within 7 days of delivery with your Order Number and photos of the delivered parcel contents.</li>
              <li>We will promptly dispatch the missing item or correct product via express shipping at our sole expense.</li>
              <li>If the correct item is out of production or cannot be manufactured, you may elect for a full refund or store credit.</li>
            </ul>
          </section>

          <!-- 10. Materially Non-Conforming Products -->
          <section id="section-10" class="policy-section">
            <span class="section-number">Section 10</span>
            <h2>10. Materially Non-Conforming Products</h2>
            <p>
              A product is considered "materially non-conforming" if it substantially differs in size, functionality, geometry, or material from what was advertised or explicitly contracted in a custom quote.
            </p>
            <p>
              If a product suffers from material non-conformance, you are entitled to request an immediate review. THE MARSHANS will evaluate the discrepancy against the product listing or custom fabrication order records, and provide a full replacement reprint, free repair, or complete refund.
            </p>
          </section>

          <!-- 11. Change of Mind Requests -->
          <section id="section-11" class="policy-section">
            <span class="section-number">Section 11</span>
            <h2>11. Change of Mind Requests</h2>
            <p>
              We handle change-of-mind requests fairly while protecting the viability of bespoke manufacturing:
            </p>
            <ul>
              <li><strong>Standard Ready-Made Catalog Items:</strong> May be accepted for return or exchange within 7 days of delivery, provided the item remains unused, intact, in original packaging, and passes warehouse quality inspection. Return shipping costs for change-of-mind returns are borne by the customer.</li>
              <li><strong>Custom & Made-to-Order Prints:</strong> Once physical printing or material preparation has started, change-of-mind returns cannot be accommodated due to the bespoke nature of the item.</li>
              <li><strong>Statutory Rights Intact:</strong> Nothing in this clause limits statutory consumer remedies for defective, damaged, or non-conforming products.</li>
            </ul>
          </section>

          <!-- 12. Cancellation Before Production -->
          <section id="section-12" class="policy-section">
            <span class="section-number">Section 12</span>
            <h2>12. Cancellation Before Production</h2>
            <p>
              If you placed an order in error and wish to cancel before manufacturing begins:
            </p>
            <ol class="step-list">
              <li>Send an urgent email to <a href="mailto:official@themarshans.shop">official@themarshans.shop</a> with the subject line: <code>URGENT: Order Cancellation - Order Reference Number</code>.</li>
              <li>State your full name, order number, and cancellation request.</li>
              <li>If your order has not yet been sliced, queued, or dispatched, our team will cancel the order immediately and issue a 100% refund.</li>
            </ol>
          </section>

          <!-- 13. Cancellation After Production Starts -->
          <section id="section-13" class="policy-section">
            <span class="section-number">Section 13</span>
            <h2>13. Cancellation After Production Starts</h2>
            <p>
              Once a 3D printer has commenced extruding or photopolymer resin exposure has started, raw materials, energy, and machine capacity have been permanently dedicated to your order.
            </p>
            <p>
              Consequently, cancellations requested after production has commenced may be restricted or subject to deduction of direct customization and material costs incurred up to that point. However, this does not affect your right to reject a product if it turns out to be defective, damaged, or non-conforming upon arrival.
            </p>
          </section>

          <!-- 14. Refund Method & Processing -->
          <section id="section-14" class="policy-section">
            <span class="section-number">Section 14</span>
            <h2>14. Refund Method & Processing</h2>
            <p>
              All approved refunds are credited back to the original payment source utilized at checkout:
            </p>
            <ul>
              <li><strong>UPI Payments:</strong> Credited directly to the originating Virtual Payment Address (VPA) / linked bank account.</li>
              <li><strong>Debit / Credit Cards:</strong> Credited to the issuing bank card account.</li>
              <li><strong>NetBanking:</strong> Reversal processed to the bank account from which funds were debited.</li>
              <li><strong>Cash on Delivery (COD) Returns:</strong> If a return is approved for a COD order, refunds are transferred via direct NEFT/IMPS bank transfer or UPI transfer upon provision of verified customer bank account details.</li>
            </ul>
            <div class="policy-callout-info">
              <strong>Processing Timeline:</strong> Once a refund is approved by THE MARSHANS, the digital reversal is initiated immediately on our payment gateway. Financial institutions typically take 5 to 7 business days depending on your bank and payment provider to reflect the credit on your bank statement.
            </div>
          </section>

          <!-- 15. Refund Amount & Itemization -->
          <section id="section-15" class="policy-section">
            <span class="section-number">Section 15</span>
            <h2>15. Refund Amount & Itemization</h2>
            <p>
              The calculated refund amount depends directly on the legal and operational grounds for the return:
            </p>
            <div class="table-responsive">
              <table class="policy-table">
                <thead>
                  <tr>
                    <th>Scenario</th>
                    <th>Product Price</th>
                    <th>Outbound Shipping</th>
                    <th>Return Shipping</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td><strong>Manufacturing Defect / Transit Damage / Studio Error</strong></td>
                    <td>100% Refunded</td>
                    <td>100% Refunded</td>
                    <td>Free / Borne by THE MARSHANS</td>
                  </tr>
                  <tr>
                    <td><strong>Cancellation Prior to Machine Production</strong></td>
                    <td>100% Refunded</td>
                    <td>100% Refunded</td>
                    <td>N/A (Not Dispatched)</td>
                  </tr>
                  <tr>
                    <td><strong>Change of Mind (Eligible Standard Product)</strong></td>
                    <td>100% Refunded</td>
                    <td>Non-refundable if service fulfilled</td>
                    <td>Borne by Customer</td>
                  </tr>
                  <tr>
                    <td><strong>Customer-Provided Measurement / File Error</strong></td>
                    <td>Assessed per salvageability</td>
                    <td>Non-refundable</td>
                    <td>Borne by Customer</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </section>

          <!-- 16. How to Request a Refund / Remedy -->
          <section id="section-16" class="policy-section">
            <span class="section-number">Section 16</span>
            <h2>16. How to Request a Refund or Replacement</h2>
            <p>
              To initiate a claim, please follow this straightforward step-by-step process:
            </p>
            <div class="process-steps">
              <div class="step-card">
                <span class="step-badge">Step 1</span>
                <h4>Contact THE MARSHANS Support</h4>
                <p>Email our dedicated desk at <a href="mailto:official@themarshans.shop">official@themarshans.shop</a>.</p>
              </div>
              <div class="step-card">
                <span class="step-badge">Step 2</span>
                <h4>Provide Order Details</h4>
                <p>State your Order Number, registered email address, and product name.</p>
              </div>
              <div class="step-card">
                <span class="step-badge">Step 3</span>
                <h4>Explain the Issue Clearly</h4>
                <p>Describe whether the issue involves transit damage, defect, wrong item, or print quality.</p>
              </div>
              <div class="step-card">
                <span class="step-badge">Step 4</span>
                <h4>Attach Visual Evidence</h4>
                <p>Include 2 to 4 well-lit photographs or a brief video highlighting the defect and outer package.</p>
              </div>
              <div class="step-card">
                <span class="step-badge">Step 5</span>
                <h4>Engineering Review</h4>
                <p>Our workshop team reviews the claim within 24 to 48 Business Hours.</p>
              </div>
              <div class="step-card">
                <span class="step-badge">Step 6</span>
                <h4>Resolution & Dispatch</h4>
                <p>Upon approval, we immediately dispatch a replacement reprint or issue your refund.</p>
              </div>
            </div>
          </section>

          <!-- 17. Refund & Quality Review Process -->
          <section id="section-17" class="policy-section">
            <span class="section-number">Section 17</span>
            <h2>17. Refund & Quality Review Process</h2>
            <p>
              When a refund or replacement request is submitted, our goal is a constructive, fair, and swift resolution. Our quality review includes examining:
            </p>
            <ul>
              <li>Digital slicing logs and print monitoring telemetry for the specific machine batch;</li>
              <li>Photographic and video documentation submitted by the customer;</li>
              <li>Carrier delivery scans and transit condition reports;</li>
              <li>Approved customization specifications and submitted CAD files.</li>
            </ul>
            <p>
              We treat every customer inquiry with respect and seek prompt resolution without unnecessary bureaucracy.
            </p>
          </section>

          <!-- 18. Protection Against Fraudulent Claims -->
          <section id="section-18" class="policy-section">
            <span class="section-number">Section 18</span>
            <h2>18. Protection Against Fraudulent Claims</h2>
            <p>
              To protect the integrity of our studio and ensure fair prices for all genuine collectors, THE MARSHANS reserves the right to decline claims where an investigation reveals intentional customer damage, fraudulent tampering, false claims of non-receipt despite verifiable biometric/OTP delivery proof, or abusive patterns of serial chargebacks.
            </p>
          </section>

          <!-- 19. Statutory Consumer Rights -->
          <section id="section-19" class="policy-section">
            <span class="section-number">Section 19</span>
            <h2>19. Statutory Consumer Rights</h2>
            <div class="statutory-highlight-box">
              <h3>CONSUMER PROTECTION LAW COMPLIANCE</h3>
              <p class="highlight-text">
                "Nothing in this Refund Policy limits any rights or remedies available to consumers under applicable law."
              </p>
              <p>
                This policy is constructed in good faith under the <strong>Consumer Protection Act, 2019</strong> and the <strong>Consumer Protection (E-Commerce) Rules, 2020</strong> of India. In the event of any perceived inconsistency between this policy and your statutory legal rights under Indian consumer protection regulations, the provisions of applicable law shall prevail.
              </p>
            </div>

            <!-- Contact Box -->
            <div class="grievance-card" style="margin-top: 36px;">
              <div class="grievance-header">
                <h3>CUSTOMER SUPPORT & GRIEVANCE REDRESSAL</h3>
                <span class="verified-pill">✓ Verified Business Entity</span>
              </div>
              <div class="grievance-grid">
                <div class="grievance-item">
                  <span class="grievance-label">Store / Brand Name</span>
                  <span class="grievance-val">THE MARSHANS</span>
                </div>
                <div class="grievance-item">
                  <span class="grievance-label">Legal Business Name</span>
                  <span class="grievance-val">THE MARSHANS</span>
                </div>
                <div class="grievance-item">
                  <span class="grievance-label">GSTIN</span>
                  <span class="grievance-val"><code>36GTSPM5280F1Z3</code></span>
                </div>
                <div class="grievance-item">
                  <span class="grievance-label">Facility Address</span>
                  <span class="grievance-val">Villa no 31 E, Hirise meadows, Mallampet, bachhupally, Hyderabad-500090, Telangana, India</span>
                </div>
                <div class="grievance-item">
