---
import Layout from '../layouts/Layout.astro';
import ShopCatalog from '../components/react/ShopCatalog.jsx';
import { getProducts } from '../lib/api/products';

const { products } = await getProducts({ limit: 50 });
---

<Layout
  title="The Catalog — THE MARSHANS | Precision 3D Printed Artifacts"
  description="Browse all 3D printed artifacts from the 5 realms: Lumo, Fandom Tribe, MiniTales, Utility Co., and Darshanam."
>
  <div class="shop-page-wrapper">
    <div class="shop-hero-header">
      <div class="container">
        <span class="section-subtitle">THE COMPLETE CATALOG</span>
        <h1 class="section-title">PRECISION ARTIFACTS & DROPS</h1>
        <p class="shop-hero-lead">
          Explore collectible statues, ambient lamps, desk gear, and sacred architectural models crafted with 0.12mm sub-micron accuracy.
        </p>
      </div>
    </div>

    <div class="container section-padding" style="padding-top: 32px;">
      <ShopCatalog client:load initialProducts={products} />
    </div>
  </div>
</Layout>

<style>
  .shop-page-wrapper {
    background-color: #ffffff;
    min-height: 80vh;
  }

  .shop-hero-header {
    background-color: #f8fafc;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    padding: clamp(48px, 6vw, 72px) 0 40px 0;
  }

  .shop-hero-lead {
    font-size: 15px;
    line-height: 1.6;
    color: #64748b;
    max-width: 580px;
    margin: 8px 0 0 0;
  }
</style>
