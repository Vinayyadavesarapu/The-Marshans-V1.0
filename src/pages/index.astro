---
import Layout from '../layouts/Layout.astro';
import HeroIntro from '../components/HeroIntro.astro';
import HomeShowcase from '../components/home/HomeShowcase.tsx';
import HomeBestSellers from '../components/home/HomeBestSellers.tsx';
import HomeProductSection from '../components/react/HomeProductSection.tsx';
import { getProducts } from '../lib/api/products';

const { products } = await getProducts({ limit: 12 });
---

<Layout
  title="THE MARSHANS — Made to be Discovered | Precision 3D Printed Artifacts"
  description="Precision 3D printed artifacts, ambient luminous sculptures, collectible figures, and functional desk gear."
  hideHeader={true}
>
  <!-- 1. Pill navigation + cinematic cloud/video hero -->
  <HeroIntro />

  <!-- 2. Full-width featured product carousel (real Store 2 products, refreshed live) -->
  <HomeShowcase client:idle initialProducts={products} />

  <!-- 3. Best Sellers: only products flagged is_best_seller in Admin (hidden until any are flagged) -->
  <HomeBestSellers client:idle initialProducts={products} />

  <!-- 4. Homepage catalogue (runtime capable) -->
  <div class="home-catalogue-head">
    <h2 class="home-catalogue-title">The Collection</h2>
    <a class="home-catalogue-link" href="/shop">Browse the full shop →</a>
  </div>
  <HomeProductSection client:load initialProducts={products} />
</Layout>

<style is:global>
  .home-catalogue-head {
    width: 100%;
    margin: 0;
    /* full-width band; content aligned with the 1440px catalogue column */
    padding: 0.5rem max(1.5rem, calc((100% - 1440px) / 2 + 1.5rem)) 0.25rem;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    box-sizing: border-box;
    background-color: #faf9f7;
  }

  .home-section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.25rem;
  }

  .home-catalogue-title {
    margin: 0;
    font-family: var(--font-sans, 'Manrope', -apple-system, sans-serif);
    font-size: clamp(24px, 3vw, 36px);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: #14251a;
  }

  .home-catalogue-link {
    font-family: var(--font-sans, 'Manrope', -apple-system, sans-serif);
    font-size: 14px;
    font-weight: 700;
    color: #2f6b45;
    text-decoration: none;
  }

  .home-catalogue-link:hover {
    text-decoration: underline;
  }

  /* Homepage catalogue: isolated renders sit fully inside the card (no cropping); transparent WebP stays
     transparent over a white stage, and the reserved aspect ratio prevents layout shift. */
  #product-cards .marshans-image-stage,
  #home-best-sellers .marshans-image-stage {
    background: #ffffff;
  }

  #product-cards .marshans-product-img,
  #home-best-sellers .marshans-product-img {
    object-fit: contain;
    padding: 6%;
    box-sizing: border-box;
  }

  .home-products-section {
    width: 100%;
    padding: 2.5rem 0 5rem;
    box-sizing: border-box;
    background-color: #faf9f7;
  }

  .home-products-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    width: 100%;
    box-sizing: border-box;
  }

  @media (max-width: 1100px) {
    .home-products-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 768px) {
    .home-products-section {
      padding: 1.5rem 0 3.5rem;
    }

    .home-products-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
      max-width: 100%;
    }
  }

  @media (max-width: 480px) {
    .home-products-grid {
      grid-template-columns: 1fr;
      max-width: 340px;
      margin: 0 auto;
    }
  }
</style>
