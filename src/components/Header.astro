---
import MarshansNavbar from './react/MarshansNavbar.tsx';
---

<!-- The one site navbar. Sticky in normal flow (reserves its own height, never overlaps content at rest).
     The wrapper is transparent at rest so the page's own background shows through; only the logo, link pill and
     controls have surfaces. `data-site-navbar` is the homepage hero's hand-off target.
     When scrolled, an opaque warm cream background prevents headings, images and cards from visually clashing. -->
<div class="site-header-sticky" id="site-navbar" data-site-navbar tabindex="-1">
  <MarshansNavbar client:load />
</div>

<script>
  // Ensure content scrolling under the sticky navbar does not overlap or clash with navbar pills
  const header = document.querySelector<HTMLElement>('.site-header-sticky');
  if (header) {
    const checkScrolled = () => {
      const isScrolled = window.scrollY > 20;
      header.classList.toggle('is-scrolled', isScrolled);
    };
    window.addEventListener('scroll', checkScrolled, { passive: true });
    checkScrolled();
  }
</script>

<style>
  .site-header-sticky {
    position: sticky;
    top: 0;
    z-index: 50;
    width: 100%;
    background: rgba(255, 255, 255, 0.72);
    backdrop-filter: blur(14px) saturate(160%);
    -webkit-backdrop-filter: blur(14px) saturate(160%);
    border-bottom: 1px solid rgba(255, 255, 255, 0.45);
    box-shadow: 0 4px 20px -2px rgba(20, 31, 23, 0.04);
  }

  .site-header-sticky:focus {
    outline: none;
  }
</style>

<style is:global>
  /* --site-nav-h: the navbar's rendered height.
     In-page links and keyboard focus stop below the sticky navbar instead of underneath it. */
  :root {
    --site-nav-h: 88px;
  }

  html {
    scroll-padding-top: calc(var(--site-nav-h) + 8px);
  }

  @media (max-width: 640px) {
    :root {
      --site-nav-h: 72px;
    }
  }

  /* Universal matte frosted-glass navigation background:
     Subtle whitish tint, soft backdrop blur, balanced transparency and matte finish.
     Distinguishes navigation while letting content softly show through. */
  .site-header-sticky {
    background: rgba(255, 255, 255, 0.72) !important;
    background-color: rgba(255, 255, 255, 0.72) !important;
    backdrop-filter: blur(14px) saturate(160%) !important;
    -webkit-backdrop-filter: blur(14px) saturate(160%) !important;
    border-bottom: 1px solid rgba(255, 255, 255, 0.45) !important;
    box-shadow: 0 4px 20px -2px rgba(20, 31, 23, 0.04) !important;
  }

  .site-header-sticky.is-scrolled {
    background: rgba(255, 255, 255, 0.82) !important;
    background-color: rgba(255, 255, 255, 0.82) !important;
    backdrop-filter: blur(16px) saturate(170%) !important;
    -webkit-backdrop-filter: blur(16px) saturate(170%) !important;
    border-bottom: 1px solid rgba(20, 31, 23, 0.06) !important;
    box-shadow: 0 6px 24px -4px rgba(20, 31, 23, 0.06) !important;
  }
</style>
